# MongoDB connection string. Leave empty in development to use an in-memory
# MongoDB (data resets on restart). Set it for persistent storage, e.g.
# MONGO_URI=mongodb://127.0.0.1:27017/djjs_hms
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/djjs_hms
MONGO_URI=mongodb+srv://djjs_app:hubguru123@cluster0.xxxxx.mongodb.net/projectIDB?retryWrites=true&w=majority&appName=Cluster0

PORT=5050
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=36h
CLIENT_ORIGIN=http://localhost:5173

# Seed demo data automatically when the database is empty
SEED_ON_EMPTY=true

# Admin login. Created on start-up, and its password is updated to match whenever
# these change. Required in production (Vercel) — the demo admin123 is never created there.
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@djjshotel.com
ADMIN_PASSWORD=change-me-to-a-strong-password
